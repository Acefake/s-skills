{
  "description": "wukong: session start check, prompt-sharpen nudge, long-running command reminder, and an ask before risky git commands",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_check.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_check.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/prompt-sharpen/scripts/improve_hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/skills/prompt-sharpen/scripts/improve_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/prompt-sharpen/scripts/improve_hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/skills/prompt-sharpen/scripts/improve_hook.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/git_guard.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/git_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
