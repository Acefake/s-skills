{
  "wukong-session": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 hooks/agy_hook.py || python hooks/agy_hook.py",
        "timeout": 10
      }
    ]
  },
  "wukong-prompt-sharpen": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 hooks/agy_hook.py || python hooks/agy_hook.py",
        "timeout": 5
      }
    ]
  },
  "wukong-git-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/git_guard.py || python hooks/git_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
