  "cards": [
    {
      "dot": "cyan",
      "title": "技能按需加载",
      "items": [
        "已有明确匹配就直接加载；wukong-router 只在不明确时兜底。",
        "20 个自动选用技能；14 个显式技能仍需点名或工作流授权。"
      ]
    },
    {
      "dot": "emerald",
      "title": "初始化同步全局规则与模型块",
      "items": [
        "wukong-init 同步全局规则，每次写入前都要用户明确确认。",
        "四角色模型块按宿主匹配检索、规划、审查、测试模型；其余子代理继承父会话。"
      ]
    },
    {
      "dot": "amber",
      "title": "不是常驻服务",
      "items": [
        "wukong 是技能与本地工具，不是独立运行的 Agent 服务。",
        "文案和只读任务不跑测试；Git 操作仍遵循已有授权。"
      ]
    }
  ]
