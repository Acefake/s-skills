  "cards": [
    {
      "dot": "cyan",
      "title": "技能按需加载",
      "items": [
        "已有明确匹配就直接加载；s-router 只在不明确时兜底。",
        "58 个自动选用技能；21 个显式技能仍需点名或工作流授权。"
      ]
    },
    {
      "dot": "emerald",
      "title": "经验有确认边界",
      "items": [
        "查询只读全局与当前项目；其他项目不混入。",
        "--confirmed 是调用方的确认声明，不独立验证聊天授权。"
      ]
    },
    {
      "dot": "amber",
      "title": "不是后台自动训练",
      "items": [
        "learn 只保存经确认的经验；reflect 仍是显式深度复盘。",
        "文案和只读任务不跑测试；Git 操作仍遵循已有授权。"
      ]
    }
  ]
